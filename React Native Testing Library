  <script>
    const slides = document.querySelectorAll('.slide');
    const progressFill = document.getElementById('progressFill');
    const slideNum = document.getElementById('slideNum');
    const notesBar = document.getElementById('notesBar');
    const notesText = document.getElementById('notesText');

    let index = 0;

    function renderSlide() {
      slides.forEach((s, i) => s.classList.toggle('active', i === index));
      progressFill.style.width = `${((index + 1) / slides.length) * 100}%`;
      slideNum.textContent = `${String(index + 1).padStart(2, '0')} / ${slides.length}`;
      notesText.textContent = slides[index].getAttribute('data-notes') || '';
    }

    function nextSlide() {
      if (index < slides.length - 1) { index++; renderSlide(); }
    }

    function prevSlide() {
      if (index > 0) { index--; renderSlide(); }
    }

    function toggleNotes() {
      notesBar.classList.toggle('open');
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen();
      }
    }

    let seconds = 0;
    let timer = null;
    const timerText = document.getElementById('timerText');

    function toggleTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      } else {
        timer = setInterval(() => {
          seconds++;
          const m = String(Math.floor(seconds / 60)).padStart(2, '0');
          const s = String(seconds % 60).padStart(2, '0');
          timerText.textContent = `${m}:${s}`;
        }, 1000);
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
        e.preventDefault();
        nextSlide();
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        prevSlide();
      } else if (e.key === 'n' || e.key === 'N') {
        toggleNotes();
      } else if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      }
    });

    renderSlide();
  </script>
